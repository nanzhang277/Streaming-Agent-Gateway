# 复制为 .env 并填写
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# PDF 示例为 deepseek-v4-flash;若账号无此型号,改为 deepseek-chat
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent Loop 最多走几轮 模型→工具 循环
MAX_LOOP_STEPS=8
# 仅在尚未产生业务事件时的自动重试次数(p35)
MAX_RETRIES=2
# SSE 心跳间隔(秒),心跳不占业务 seq
HEARTBEAT_SECONDS=15
# 取消宽限期:协作式取消未退出则升级 task.cancel()(p29)
CANCEL_GRACE_SECONDS=15
# tool.completed 事件里 result 预览的最大字符数
EVENT_PREVIEW_CHARS=2000
# 工具可访问的根目录(list_dir / read_file 不得越界)
TOOL_ROOT=.
